<%- include('partials/header.ejs'); -%>

<div class="max-w-7xl mx-auto my-10 p-6">
  <!-- Header -->
  <div class="mb-4 text-sm text-gray-600">
    Home > Donation Opportunities > <span id="case-path-name" class="text-gray-800 font-medium"></span>
  </div>

  <!-- Project Title -->
  <div class="bg-white p-6 rounded-lg shadow-md">
    <div class="flex justify-between flex-wrap items-start">
      <div class="w-full pr-6 lg:w-2/3">
        <h2 id="case-heading" class="text-2xl font-bold text-gray-800 mb-2"></h2>
        <div class="flex items-center gap-4 text-sm text-gray-600 mb-4">
          <span id="case-city"></span>
          <span id="case-dates"></span>
          <span id="case-beneficiaries"></span>
        </div>

        <!-- Place holder progress bar -->
        <div id="case-progress"></div>

        <!-- Project Details -->
        <section aria-labelledby="case-details-heading">
          <h3 id="case-details-heading" class="font-semibold text-gray-800 mt-6 mb-2">Case Details</h3>
          <p id="case-description" class="text-gray-700 mb-6"></p>
        </section>

        <!-- Placeholder for association info -->
        <section id="association-info" aria-labelledby="association-heading"></section>

      </div>

      <!-- Donation Box -->
      <aside aria-label="Donation Box" class="w-full lg:w-1/3 mt-6 lg:mt-0 bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <img id="case-image" src="https://www.solidbackgrounds.com/images/640x480/640x480-anti-flash-white-solid-color-background.jpg" alt="Donation Illustration" class="rounded mb-4" />

        <!-- Placeholder for donation input component -->
        <div id="donation-component"></div>

        <p class="text-xs text-gray-500 mb-3">By proceeding with the payment, you agree to the <a href="#" class="text-green-600 underline">donation terms and conditions</a>.</p>
        <div class="flex gap-2">
          <button class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700" aria-label="Donate">Donate</button>
          <button id="cart-btn" class="p-2 text-gray-500 hover:text-green-700" aria-label="View cart">
            <!-- Cart Icon -->
            🛒
          </button>
        </div>
      </aside>
    </div>
  </div>
</div>

<script type="module" src="/scripts/case/case.js"></script>
<%- include('partials/footer.ejs'); -%>