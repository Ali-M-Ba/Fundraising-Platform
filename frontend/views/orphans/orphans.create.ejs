<%- include('../partials/header'); -%>

<section class="p-6 bg-gray-100 max-w-3xl mx-auto">
  <h2 class="text-2xl font-bold mb-4">Create/Edit Orphan</h2>
  <form action="/orphans" method="POST" class="space-y-4">
    <input type="text" name="name" placeholder="Name" class="w-full border p-2 rounded" required />
    <input type="number" name="nationalNumber" placeholder="National Number" class="w-full border p-2 rounded" required />
    <input type="number" name="age" placeholder="Age" class="w-full border p-2 rounded" required />

    <select name="gender" class="w-full border p-2 rounded" required>
      <option value="">Select Gender</option>
      <option value="Male">Male</option>
      <option value="Female">Female</option>
    </select>

    <select name="healthStatus" class="w-full border p-2 rounded" required>
      <option value="">Health Status</option>
      <option value="Healthy">Healthy</option>
      <option value="Minor Health Issues">Minor Health Issues</option>
      <option value="Disabled">Disabled</option>
    </select>

    <input type="text" name="orphanageId" placeholder="Orphanage ID" class="w-full border p-2 rounded" required />

    <div class="flex gap-4">
      <input type="text" name="location[city]" placeholder="City" class="w-full border p-2 rounded" required />
      <input type="text" name="location[country]" placeholder="Country" class="w-full border p-2 rounded" required />
    </div>

    <textarea name="bio" placeholder="Bio" class="w-full border p-2 rounded"></textarea>

    <div class="space-y-2">
      <h3 class="text-lg font-semibold">Needs</h3>
      <div class="flex gap-4">
        <input type="text" name="needs[0][category]" placeholder="Category" class="w-full border p-2 rounded" />
        <input type="number" name="needs[0][amountNeeded]" placeholder="Amount Needed" class="w-full border p-2 rounded" />
      </div>
    </div>

    <label class="flex items-center">
      <input type="checkbox" name="isSponsored" class="mr-2" />
      Sponsored
    </label>

    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded">Save</button>
  </form>
</section>

<%- include('../partials/footer'); -%>