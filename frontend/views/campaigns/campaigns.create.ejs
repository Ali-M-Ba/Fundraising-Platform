<%- include('../partials/header'); -%>

<section class="p-6 bg-gray-100 max-w-3xl mx-auto">
  <h2 class="text-2xl font-bold mb-4">Create/Edit Campaign</h2>
  <form action="/campaigns" method="POST" class="space-y-4">
    <input type="text" name="title" placeholder="Title" class="w-full border p-2 rounded" required />
    <textarea name="description" placeholder="Description" class="w-full border p-2 rounded" required></textarea>
    <input type="number" name="Beneficiaries" placeholder="Number of Beneficiaries" class="w-full border p-2 rounded" required />
    <div class="flex gap-4">
      <input type="text" name="location[city]" placeholder="City" class="w-full border p-2 rounded" required />
      <input type="text" name="location[country]" placeholder="Country" class="w-full border p-2 rounded" required />
    </div>
    <input type="text" name="orphanageId" placeholder="Orphanage ID" class="w-full border p-2 rounded" required />
    <input type="number" name="targetAmount" placeholder="Target Amount" class="w-full border p-2 rounded" required />
    <input type="date" name="startDate" class="w-full border p-2 rounded" required />
    <input type="date" name="endDate" class="w-full border p-2 rounded" required />
    <select name="status" class="w-full border p-2 rounded" required>
      <option value="active">Active</option>
      <option value="completed">Completed</option>
      <option value="canceled">Canceled</option>
    </select>
    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded">Save</button>
  </form>
</section>

<%- include('../partials/footer'); -%>