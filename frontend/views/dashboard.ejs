<%- include('partials/header'); -%>

<!-- Sidebar/Main Layout -->
<div class="flex h-screen bg-gray-100">
  <aside class="w-64 bg-white shadow-lg flex flex-col">
    <div class="p-6 text-2xl font-bold border-b">Dashboard</div>
    <nav class="flex-1 p-4 space-y-2">
      <a href="/dashboard/orphanages" class="block px-4 py-2 rounded hover:bg-green-100 text-gray-700">🏠 Orphanages</a>
      <a href="/dashboard/orphans" class="block px-4 py-2 rounded hover:bg-green-100 text-gray-700">🧒 Orphans</a>
      <a href="/dashboard/campaigns" class="block px-4 py-2 rounded hover:bg-green-100 text-gray-700">🎯 Campaigns</a>
    </nav>
  </aside>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col">
    <!-- Top Bar -->
    <header class="bg-white shadow px-6 py-4 flex items-center justify-between">
      <div class="text-xl font-semibold">Welcome, Admin</div>
      <div>
        <button class="bg-green-600 text-white px-4 py-2 rounded">Logout</button>
      </div>
    </header>

    <!-- Page Content -->
    <main class="p-6 overflow-y-auto flex-1">
      <div class="text-2xl font-bold mb-4">Dashboard Overview</div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card: Orphanages -->
        <div class="bg-white p-6 rounded shadow-md text-center border">
          <div class="text-lg font-semibold mb-2">Orphanages</div>
          <div class="text-4xl font-bold text-green-600">8</div>
          <a href="/dashboard/orphanages" class="text-green-600 mt-2 inline-block hover:underline">Manage</a>
        </div>
        <!-- Card: Orphans -->
        <div class="bg-white p-6 rounded shadow-md text-center border">
          <div class="text-lg font-semibold mb-2">Orphans</div>
          <div class="text-4xl font-bold text-green-600">120</div>
          <a href="/dashboard/orphans" class="text-green-600 mt-2 inline-block hover:underline">Manage</a>
        </div>
        <!-- Card: Campaigns -->
        <div class="bg-white p-6 rounded shadow-md text-center border">
          <div class="text-lg font-semibold mb-2">Campaigns</div>
          <div class="text-4xl font-bold text-green-600">5</div>
          <a href="/dashboard/campaigns" class="text-green-600 mt-2 inline-block hover:underline">Manage</a>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('partials/footer'); -%>