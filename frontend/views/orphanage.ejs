<%- include('partials/header'); -%>

<!-- Header Section -->
<header class="h-80 bg-green-900 text-white">
  <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col lg:flex-row justify-between items-center gap-8">
    <!-- Left: Info -->
    <div>
      <h1 id="orphanage-name" class="text-4xl font-bold mb-2">Wadi Al-Jazl Charity Association</h1>
      <p id="orphanage-location" class="text-xl text-gray-200 flex items-center gap-1 mb-4">📍 Madinah</p>
    </div>
    <!-- Right: Logo -->
    <div class="flex-shrink-0">
      <img id="orphanage-image" src="https://placehold.co/120x120/10B981/fff?text=Logo" alt="Charity Logo" class="w-64 h-64 object-contain rounded-xl bg-white p-2">
    </div>
  </div>
</header>

<!-- Stats -->
<section id="charity-stats" class="max-w-xl mx-auto px-6 py-6 bg-white shadow rounded-xl -mt-10 relative z-10 grid grid-cols-2 text-center divide-x divide-gray-200" aria-label="Charity statistics">
  <div id="stats-orphans">
    <p id="orphans-count" class="text-2xl font-bold text-green-700"></p>
    <p class="text-sm text-gray-600">Orphans</p>
  </div>
  <div id="stats-campaigns">
    <p id="campaigns-count" class="text-2xl font-bold text-green-700"></p>
    <p class="text-sm text-gray-600">Campaigns</p>
  </div>
</section>

<!-- About Section -->
<section id="about-section" class="h-80 w-full bg-white -mt-16 flex items-center" aria-labelledby="about-heading">
  <div class="w-full max-w-7xl px-8 mx-auto">
    <h2 class="text-green-700 text-3xl font-bold mb-6">About the charity</h2>
    <p id="orphanage-description" class="text-lg md:text-xl text-gray-700 max-w-4xl">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla facilisi. Duis vel elit at quam ullamcorper tincidunt.
    </p>
  </div>
</section>

<!-- Donation Opportunities -->
<main id="donation-opportunities" class="my-10 mx-auto max-w-7xl px-8 py-8" aria-labelledby="opportunities-heading">
  <!-- Heading -->
  <header id="opportunities-header" class="flex justify-between items-center mb-8 px-8 py-4 bg-white rounded-full">
    <h1 id="opportunities-heading" class="text-3xl font-bold text-green-700">Orphanage Opportunities</h1>
    <!-- Tabs -->
    <nav id="opportunity-tabs" aria-label="Donation opportunity tabs">
      <div class="flex space-x-4">
        <button id="orphan-btn" class="px-4 py-2 bg-green-600 text-white font-semibold rounded-full hover:bg-green-700 transition">
          Orphans
        </button>
        <button id="campaign-btn" class="px-4 py-2 bg-gray-200 text-gray-700 font-semibold rounded-full hover:bg-gray-300 transition">
          Campaigns
        </button>
      </div>
    </nav>
  </header>

  <!-- Cards Container -->
  <section id="cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" aria-label="Donation cards"></section>
</main>

<!-- Contact -->
<section class="w-full py-12 bg-white">
  <div class="max-w-7xl px-8 mx-auto">
    <h2 id="contact-heading" class="text-green-700 text-3xl font-bold mb-6">Contact Us</h2>
    <p id="contact-info" class="text-lg md:text-xl text-gray-700 max-w-4xl">Phone: 0543675549 · Mobile Phone: 0543675549</p>
  </div>
</section>

<script type="module" src="/scripts/orphanage/orphanage.js"></script>
<%- include('partials/footer'); -%>