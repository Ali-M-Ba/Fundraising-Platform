<%- include('../../partials/header'); -%>


<div class="flex bg-green-100">
  <%- include('../../partials/sidebar'); -%>
  <section class="m-4 ml-2 bg-white w-full">
    <header class="bg-gradient-to-r from-green-700 to-green-500 rounded-t-lg px-5 py-6 mb-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-semibold text-white">Campaign Details</h2>
        <p class="text-green-100 mt-1">
          Please provide the information for the campaign.
        </p>
      </div>
    </header>
    <div class="max-w-4xl mx-auto">


      <form action="/campaigns" method="POST" class="space-y-6">
        <!-- Basic Info -->
        <div class="space-y-1">
          <label class="block text-sm font-semibold text-gray-700">Title</label>
          <input type="text" name="title" placeholder="Campaign Title" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition-all" required />
        </div>

        <div class="space-y-1">
          <label class="block text-sm font-semibold text-gray-700">Description</label>
          <textarea name="description" rows="4" placeholder="Describe the campaign goals and purpose..." class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none resize-none" required></textarea>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Number of Beneficiaries</label>
            <input type="number" name="beneficiaries" placeholder="e.g. 100" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
          </div>

          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Target Amount</label>
            <input type="number" name="targetAmount" placeholder="Target Amount" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
          </div>
        </div>

        <!-- Location -->
        <div class="pt-4 border-t border-gray-100">
          <h3 class="text-lg font-medium text-gray-800 mb-4">Location</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" name="location-city" placeholder="City" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
            <input type="text" name="location-country" placeholder="Country" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
          </div>
        </div>

        <!-- Dates -->
        <div class="pt-4 border-t border-gray-100">
          <h3 class="text-lg font-medium text-gray-800 mb-4">Timeline</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="block text-sm font-medium text-gray-600">Start Date</label>
              <input type="date" name="startDate" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
            </div>

            <div class="space-y-1">
              <label class="block text-sm font-medium text-gray-600">End Date</label>
              <input type="date" name="endDate" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
            </div>
          </div>
        </div>

        <!-- Meta -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-gray-100">
          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Orphanage ID</label>
            <input type="text" name="orphanageId" placeholder="Orphanage ID" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
          </div>

          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Status</label>
            <select name="status" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
              <option value="active">Active</option>
              <option value="completed">Completed</option>
              <option value="canceled">Canceled</option>
            </select>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex justify-end pt-6">
          <button type="button" class="px-3 py-1 text-gray-600 font-medium mr-4 hover:underline">
            Cancel
          </button>
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg shadow-lg hover:shadow-xl transition-all active:scale-95">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </section>

</div>
<script type="module" src="/scripts/dashboard/campaigns/dashboard.campaigns.create.js"></script>
<%- include('../../partials/footer'); -%>