<%- include('../../partials/header'); -%>


<div class="flex bg-green-100">
  <%- include('../../partials/sidebar'); -%>
  <section class="m-4 ml-2 bg-white w-full">
    <header class="bg-gradient-to-r from-green-700 to-green-500 rounded-t-lg px-5 py-6 mb-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-semibold text-white">Orphan Profile</h2>
        <p class="text-green-100 mt-1">
          Please provide the details for the orphan.
        </p>
      </div>
    </header>

    <div class="max-w-4xl mx-auto">
      <form class="space-y-6">
        <!-- Basic Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Name</label>
            <input type="text" name="name" placeholder="Full Name" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition-all" required />
          </div>

          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">National Number</label>
            <input type="number" name="nationalNumber" placeholder="National Number" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition-all" required />
          </div>

          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Age</label>
            <input type="number" name="age" placeholder="Age" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition-all" required />
          </div>

          <div class="space-y-1">
            <label class="block text-sm font-semibold text-gray-700">Orphanage ID</label>
            <input type="text" name="orphanageId" placeholder="Orphanage ID" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition-all" required />
          </div>
        </div>

        <!-- Selects -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1">
            <label class="block text-sm font-medium text-gray-600">Gender</label>
            <select name="gender" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
              <option value="">Select Gender</option>
              <option>Male</option>
              <option>Female</option>
            </select>
          </div>

          <div class="space-y-1">
            <label class="block text-sm font-medium text-gray-600">Health Status</label>
            <select name="healthStatus" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
              <option value="">Health Status</option>
              <option>Healthy</option>
              <option>Minor Health Issues</option>
              <option>Disabled</option>
            </select>
          </div>
        </div>

        <!-- Location -->
        <div class="pt-4 border-t border-gray-100">
          <h3 class="text-lg font-medium text-gray-800 mb-4">Location</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" id="city" name="location-city" placeholder="City" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
            <input type="text" id="country" name="location-country" placeholder="Country" class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required />
          </div>
        </div>

        <!-- Bio -->
        <div class="space-y-1 pt-4 border-t border-gray-100">
          <label class="block text-sm font-semibold text-gray-700">Bio</label>
          <textarea name="bio" id="bio" rows="4" placeholder="Brief background or notes..." class="w-full border border-gray-300 p-2 rounded-lg focus:ring-2 focus:ring-green-500 outline-none resize-none"></textarea>
        </div>

        <!-- Needs -->
        <div class="pt-4 border-t border-gray-100 space-y-4">
          <h3 class="text-lg font-medium text-gray-800">Needs</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" id="category" name="needs-category" placeholder="Category" class="w-full border border-gray-300 p-2 rounded-lg" />
            <input type="number" id="amountNeeded" name="needs-amountNeeded" placeholder="Amount Needed" class="w-full border border-gray-300 p-2 rounded-lg" />
          </div>
        </div>

        <!-- Sponsored -->
        <label class="flex items-center pt-4">
          <input type="checkbox" id="isSponsored" name="isSponsored" class="mr-2" />
          <span class="text-sm text-gray-700">Sponsored</span>
        </label>

        <!-- Actions -->
        <div class="flex justify-end pt-6">
          <button type="button" class="px-3 py-1 text-gray-600 font-medium mr-4 hover:underline">
            Cancel
          </button>
          <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold px-4 py-2 rounded-lg shadow-lg hover:shadow-xl transition-all active:scale-95">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </section>

</div>

<script type="module" src="/scripts/dashboard/orphans/dashboard.orphans.create.js"></script>
<%- include('../../partials/footer'); -%>